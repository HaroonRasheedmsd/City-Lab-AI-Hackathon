# ==============================================================================
# CityLab Diagnostics — Environment Configuration Template
# Copy this file to .env and provide your API keys. No real secrets should be here.
# ==============================================================================

# LLM Providers (Multi-tier resilient fallback chain: Gemini -> Groq -> OpenRouter -> Deterministic Template)
# Leave blank to use zero-cost deterministic offline templates (0% failure rate)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Frontend Configuration
# When deployed with Docker or Vite dev proxy, leave as /api or empty.
# For remote backend deployment (e.g. Render/Railway), set the full URL:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=
